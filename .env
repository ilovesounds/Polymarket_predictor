# --- Core mode ---
PAPER_TRADE=true
STARTING_BANKROLL=20

# --- Wallet / execution (unused in hard PAPER mode) ---
PRIVATE_KEY=
POLYGON_RPC=https://polygon-rpc.com

# --- Optional RPC upgrade (recommended for reliability) ---
# Example: Alchemy/Infura/QuickNode Polygon HTTPS endpoint
# POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Optional Polymarket API creds (only if you later wire authenticated endpoints) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Optional feed overrides ---
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade

# --- Rust feeds-rs (rust/feeds-rs) — NATS publisher ---
# NATS_URL=nats://127.0.0.1:4222
# ORDERBOOK_POLL_MS=1000
# MARKET_REFRESH_MS=45000

# --- BTC short-window market filter ---
# 5 = only 5-minute windows, 15 = only 15-minute (default), both = 5m and 15m
MARKET_WINDOW=15

# --- Live dashboard (npm run dashboard) ---
DASHBOARD_PORT=3847
# Verbose Polymarket stream logs on the dashboard server
# DEBUG_POLY_STREAM=true
# Bot pushes entry/exit events when true (npm run paper:live / npm run dev)
ENABLE_DASHBOARD_FEED=true

# --- NATS messaging (npm run nats:up / npm run dev:nats) ---
# Client URL (Node dashboard, bot, feeds publisher, Rust feeds)
NATS_URL=disabled
# Monitoring UI: http://localhost:8222
# Disable NATS entirely: NATS_URL=disabled
USE_NATS=false
# Dashboard ingests feeds via NATS (requires feeds/natsPublisher.js). Default off for npm run dashboard.
# USE_NATS_FEEDS=true
# Bot consumes Binance ticks from NATS (requires feeds publisher or Rust feeds)
BOT_USE_NATS_FEEDS=false
# Reconnect backoff cap (ms) and UI dedup window (ms)
NATS_RECONNECT_MAX_MS=30000
NATS_DEDUP_MS=400

# --- Trade logging controls ---
VERBOSE_TRADE_LOGS=true
TRADE_LOG_JSON=true