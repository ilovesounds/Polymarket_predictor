# =============================================================================
# Polymarket BTC bot — environment template
# Copy to `.env` and adjust. See /docs and docs/MAINTENANCE.md.
# =============================================================================

# --- Core mode ---
PAPER_TRADE=true
# Initial paper bankroll baseline (.env only). Add/remove liquid cash anytime via
# Portfolio or Bot dashboard (persisted in data/cash-adjustments.json).
STARTING_CASH=20
# Legacy alias (still read by bot, dashboard, Strategy Lab, backtest docs):
# STARTING_BANKROLL=20

# --- Exit mode (bot/PolymarketBot.js) ---
# Default: hold until market resolves ($1/share if YES wins, $0 if NO).
# Set a target to sell YES when midpoint >= price (paper sim at current mid).
# BOT_EXIT_TARGET_PRICE=0.85
# BOT_TAKE_PROFIT_PRICE=0.85
# BOT_EXIT_MODE=resolve_only
# BOT_EXIT_MODE=fixed_price

# --- Bet sizing (paper bot; Strategy Lab preset overrides when applied) ---
# compound = 100% of cash per trade | fixed = FIXED_BET_USD | kelly = Kelly + liquidity cap
SIZING_MODE=compound
POSITION_CASH_FRACTION=1
FIXED_BET_USD=5
# KELLY_FRACTION_CAP=0.08
# KELLY_DEFAULT_WIN_RATE=0.55

# --- Wallet / execution (unused in hard PAPER mode) ---
PRIVATE_KEY=
POLYGON_RPC=https://polygon-rpc.com
# POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Optional Polymarket API creds (authenticated endpoints only) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- External feeds ---
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@aggTrade

# --- BTC market window filter (bot + backtest) ---
# 5 | 15 | 1440 (1d) | both (5+15) | all (5+15+1d)
MARKET_WINDOW=all
# Bot-only override when spawned from dashboard Bot page:
# BOT_MARKET_WINDOW=15m

# --- Bot session (bot/SessionManager.js) ---
# BOT_SESSION_MODE=indefinite | timed | trades | pnl
# BOT_SESSION_PNL_STOP=-10
# BOT_SESSION_PNL_TARGET=25
# Legacy run limits (overridden by BOT_SESSION_MODE when set):
# BOT_RUN_LIMIT_MODE=unlimited
# BOT_RUN_LIMIT_TRADES=11

# --- Bot profile (dashboard Bot / Strategy Lab → data/bot-profile.json) ---
# BOT_STOP_LOSS_PCT=10
# BOT_STOP_LOSS_PRICE=0.45
# BOT_STOP_THRESHOLD=0.45
# BOT_ENTRY_MIN_SECONDS=30
# BOT_ENTRY_MAX_SECONDS=270
# BOT_ENTRY_MIN_PRICE=0.48
# BOT_ENTRY_MAX_PRICE=0.92
# BOT_MAX_TRADES_PER_MARKET=1

# --- Strategy router (bot/StrategyRouter.js) ---
# BOT_STRATEGY=deterministic_yes_50
# BOT_STRATEGIES=momentum_confirmed_yes_50,deterministic_yes_50
# BOT_POLL_INTERVAL_MS=30000
# BOT_USE_WS=true
# BOT_WS_EVAL_THROTTLE_MS=250
# BOT_PRICE_BUFFER_SIZE=50
# BOT_GAMMA_CACHE_MS=40000
# BOT_ENRICH_PRICE_HISTORY=false
# BOT_PRICE_HISTORY_HOURS=1

# --- Live dashboard (npm run dashboard) ---
DASHBOARD_PORT=3847
DASHBOARD_POLY_MODE=15m
# MARKET_REFRESH_MS=45000
# MARKET_ROLL_CHECK_MS=5000
# DEBUG_POLY_STREAM=true
ENABLE_DASHBOARD_FEED=true

# --- NATS (npm run nats:up / npm run dev:nats) ---
# For dashboard-only: leave disabled or NATS_URL=disabled
NATS_URL=disabled
USE_NATS=false
NATS_CONNECT_TIMEOUT_MS=8000
# USE_NATS_FEEDS=true
BOT_USE_NATS_FEEDS=false
NATS_RECONNECT_MAX_MS=30000
NATS_DEDUP_MS=400

# --- Rust feeds-rs (rust/feeds-rs) ---
# ORDERBOOK_POLL_MS=1000

# --- Trade logging ---
VERBOSE_TRADE_LOGS=true
TRADE_LOG_JSON=true

# --- Strategy Lab (microstructure params + gates) ---
# LAB_MAX_SPREAD_CENTS=5
# LAB_MIN_DEPTH_USD=1000
# LAB_MIN_VOLUME_24H=0
# LAB_MAX_IMBALANCE=0.8
# LAB_MAX_SLIPPAGE_PCT=2
# LAB_MAX_POSITION_PCT_LIQUIDITY=5
# LAB_TICKS_FROM_MID=3
# LAB_TICK_SIZE=0.01
# LAB_GATE_MODE=warn
# Preset fields also in data/strategy-presets.json: sizingMode, fixedBetUsd, betPercent, kellyFractionCap
# SIZING_MODE=compound|fixed|percent|amount_cap|kelly
# BET_PERCENT_OF_BANKROLL=25
# BOT_PROFILE_ID=conservative-25
